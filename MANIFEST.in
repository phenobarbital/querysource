
include LICENSE
include CHANGES.rst
include CONTRIBUTING.md
include INSTALL
include README.md
include pyproject.toml
include setup.py
include Makefile
global-include *.typed
# Whitelist: only include QS package
graft querysource
graft tests
# Global excludes
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.o
global-exclude .git*
global-exclude .DS_Store
global-exclude .venv
# Exclude Cython-generated .so files (they are compiled during wheel build)
# but keep Rust extension .so files bundled in qs_parsers
recursive-exclude querysource/parsers *.so
recursive-exclude querysource/types *.so
recursive-exclude querysource/utils *.so
# setuptools-scm adds every git-tracked file to the sdist, so anything not
# needed to build querysource from source must be pruned explicitly.
# Agent / SDD tooling
prune .agent
prune .agents
prune .claude
prune .codex
prune .parrot
prune agents
prune sdd
# Repository tooling and CI
prune .github
prune .jupyter
prune bin
prune scripts
# Docs, samples and local development assets
prune docs
prune samples
prune examples
prune settings
prune plugins
prune my_prompts
prune lab
prune generated
prune policies
prune reference
prune static
prune templates
# Rust crates are prebuilt into querysource/qs_parsers and querysource/qsurl
# by the release workflow; setup.py does not build them from the sdist.
prune rust
# Dev-only root files
exclude CLAUDE.md AGENTS.md JOIN_CONDITIONS_*.md
exclude app.py run.py nav.py gunicorn_config.py
exclude uv.lock tox.ini mypy.ini .pylintrc .isort.cfg
exclude .pre-commit-config.yaml .bumpversion.cfg
global-exclude __pycache__/*
