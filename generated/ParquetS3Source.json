    {"name": "credentials.aws_key", "type": "Any", "default": "AWS_ACCESS_KEY_ID", "required": false, "description": ""},
    {"name": "credentials.aws_secret", "type": "Any", "default": "AWS_SECRET_ACCESS_KEY", "required": false, "description": ""},
    {"name": "credentials.profile", "type": "Any", "default": null, "required": false, "description": ""},
    {"name": "credentials.anon", "type": "Any", "default": false, "required": false, "description": ""},
