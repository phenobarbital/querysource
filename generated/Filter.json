{
  "name": "Filter",
  "category": "Operators",
  "description": "Filter rows in a DataFrame based on declarative conditions or field mappings.",
  "usage": "Use in a MultiQuery pipeline to reduce a DataFrame to only the rows that satisfy specified conditions, equivalent to SQL WHERE clauses.",
