  "example": "{\n    \"Filter\": {\n        \"conditions\": [\n            {\"column\": \"status\", \"expression\": \"==\", \"value\": \"active\"},\n            {\"column\": \"revenue\", \"expression\": \">\", \"value\": 1000}\n        ],\n        \"operator\": \"&\"\n    }\n}",
  "icon": "git-merge"
