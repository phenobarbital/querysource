{
  "name": "Map",
  "category": "Transformations",
  "description": "Rename, select, or compute columns in a DataFrame (shape mapping) inside a MultiQuery ``Transform`` step.",
  "usage": "``fields`` maps each target column to a source. A string value renames/copies a source column; an object value ``{func: {args}}`` applies one or more named transform functions; a list value applies a positional function call (``[func, {args}]``) or several. ``drop_columns`` removes columns after mapping.",
  "attributes": [
    {
      "name": "replace_columns",
      "type": "bool",
      "default": false,
      "required": false,
      "description": "If ``True``, drop each mapped source column after copying it to the target (replace in-place). When ``False`` (default) the source column is kept."
    },
    {
      "name": "reset_index",
      "type": "bool",
      "default": false,
      "required": false,
      "description": "If ``True``, reset the DataFrame index (``drop=True``) after mapping. Default ``False``."
    },
    {
      "name": "fields",
      "type": "dict",
      "default": null,
      "required": true,
      "description": "Mapping of target column name to its source: a source column name (rename/copy), an object of transform-function calls, or a list of positional function calls."
    },
    {
      "name": "drop_columns",
      "type": "list",
      "default": null,
      "required": false,
      "description": "Column name(s) to drop from the result after mapping."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Map",
    "type": "object",
    "properties": {
      "replace_columns": {
        "type": "boolean",
        "description": "If ``True``, drop each mapped source column after copying it to the target (replace in-place). When ``False`` (default) the source column is kept.",
        "default": false
      },
      "reset_index": {
        "type": "boolean",
        "description": "If ``True``, reset the DataFrame index (``drop=True``) after mapping. Default ``False``.",
        "default": false
      },
      "fields": {
        "type": "object",
        "description": "Target column -> source column or transform-function spec.",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "description": "Source column name to copy/rename from."
            },
            {
              "type": "object",
              "description": "Transform functions to apply: {function: {args}}.",
              "propertyNames": {
                "$ref": "#/$defs/transformFunc"
              },
              "additionalProperties": {
                "type": "object",
                "description": "Keyword arguments for the transform function."
              }
            },
            {
              "type": "array",
              "description": "Positional function call(s): [function, {args}] or a list thereof."
            }
          ]
        }
      },
      "drop_columns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Columns to drop after mapping."
      }
    },
    "required": [
      "fields"
    ],
    "additionalProperties": true,
    "description": "Reshape a DataFrame by mapping target columns to source columns or transform functions. ``fields`` is required.",
    "$defs": {
