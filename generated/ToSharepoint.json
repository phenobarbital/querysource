  "example": "{\n  \"Output\": [\n    {\n      \"ToSharepoint\": {\n        \"credentials\": {\n          \"client_id\": \"SHAREPOINT_APP_ID\",\n          \"client_secret\": \"SHAREPOINT_APP_SECRET\",\n          \"tenant_id\": \"SHAREPOINT_TENANT_ID\",\n          \"site\": \"Roadshows\"\n        },\n        \"destination\": {\n          \"filename\": \"2025 Events Master Schedule.xlsx\",\n          \"directory\": \"Shared Documents/General/Schedule\"\n        }\n      }\n    }\n  ]\n}",
