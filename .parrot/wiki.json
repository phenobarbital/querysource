{
  "wiki_name": "querysource",
  "storage_dir": ".parrot/wiki",
  "backend": "sqlite",
  "include_suffixes": [],
  "exclude_dirs": [
    ".parrot/wiki"
  ],
  "body_max_chars": 16000,
  "max_file_kb": 512,
  "claude": {
    "nudge_cooldown_seconds": 60,
    "nudge_tools": [
      "Grep",
      "Glob",
      "Read",
      "Bash"
    ]
  },
  "sync_graph": false,
  "arango_database": null,
  "arango_credentials_env": "ARANGODB",
  "arango_text_analyzer": "text_en",
  "vault_dir": null,
  "namespaces": {},
  "obsidian_sync": null,
  "symbol_depth": 2,
  "structural_backend": true,
  "decisions": {
    "enabled": true,
    "adr_globs": [
      "docs/adr/**/*.md",
      "docs/adrs/**/*.md",
      "docs/decisions/**/*.md"
    ],
    "max_records": 10000,
    "generation_enabled": false,
    "max_input_tokens": 12000,
    "max_output_tokens": 2000,
    "max_files": 8,
    "max_candidates": 3,
    "timeout_seconds": 60
  },
  "schema": {
    "enabled": true,
    "sources": {},
    "stale_after_days": {
      "1": 30,
      "2": 14,
      "3": 7
    }
  },
  "standup": {
    "default_language": "en",
    "horizon_days": 7,
    "timezone": null,
    "week_start": "monday",
    "out_dir": null,
    "me": {
      "wiki": null,
      "jira_account_id": null,
      "jira_display_name": null,
      "aliases": []
    },
    "ticket_status_map": {
      "To Do": "open",
      "Open": "open",
      "Backlog": "open",
      "In Progress": "in-progress",
      "Blocked": "blocked",
      "In Review": "in-review",
      "Code Review": "in-review",
      "Done": "closed",
      "Closed": "closed",
      "Resolved": "closed"
    },
    "project_map": {},
    "stale_ticket_days": 10,
    "stale_decision_days": 14,
    "llm_env": "WIKI_LIGHTWEIGHT_MODEL"
  },
  "sqlite_busy_timeout": 15.0,
  "sqlite_performance_pragmas": false,
  "inbox": {
    "dir": "inbox",
    "archive_dir": ".parrot/archive",
    "rejected_subdir": "rejected",
    "markdown_dir": null,
    "date_format": "%Y-%m-%d",
    "stage_git": true,
    "max_candidates": 20,
    "lock_timeout": 30.0
  }
}
